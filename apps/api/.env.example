NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/handyconnect

JWT_SECRET=change-me-access-secret
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRE=30d

# Comma-separated. Expo dev server + admin (Vite) by default.
CORS_ORIGIN=http://localhost:8081,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# OTP: in development the code is logged and returned as `devCode`.
OTP_TTL_MINUTES=10

# Seeded admin (dashboard login)
ADMIN_EMAIL=admin@handyconnect.co.za
ADMIN_PASSWORD=ChangeMe123!

# Added in later milestones
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
EXPO_ACCESS_TOKEN=
