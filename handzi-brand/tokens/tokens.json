{
  "$description": "Handzi design tokens v1.0. Source of truth for colour, type, spacing, radius, shadow and motion. Map these into any stack (CSS, Tailwind, React Native, Flutter).",
  "color": {
    "brand": {
      "orange":   { "value": "#EA580C", "use": "Brand graphics, logo, icons, large text (24px+), highlights on dark. NOT for small text or white-text buttons." },
      "brick":    { "value": "#C2410C", "use": "Primary buttons (white text), links, active states. White on brick = 5.18:1." },
      "brickDark":{ "value": "#9A3412", "use": "Primary button hover/pressed." },
      "sunshine": { "value": "#FFC94A", "use": "Tape band, highlights, badges, ratings stars, secondary buttons (charcoal text)." },
      "sunshineDark": { "value": "#E0A520", "use": "Sunshine hover/pressed, star outline." }
    },
    "neutral": {
      "charcoal": { "value": "#1C1F24", "use": "Primary text, dark surfaces, nav bars." },
      "graphite": { "value": "#33373E", "use": "Dark-mode cards and borders." },
      "steel":    { "value": "#5B6068", "use": "Secondary text on light. 5.81:1 on chalk." },
      "mist":     { "value": "#A3A8B0", "use": "Secondary text on dark only, placeholders on dark, disabled icons." },
      "line":     { "value": "#E2DED6", "use": "Borders, dividers on light." },
      "chalk":    { "value": "#F7F5F0", "use": "App background (light)." },
      "white":    { "value": "#FFFFFF", "use": "Cards, inputs, sheets." }
    },
    "status": {
      "success": { "value": "#15803D", "use": "Verified badge, job completed." },
      "danger":  { "value": "#B91C1C", "use": "Errors, cancel, destructive." },
      "info":    { "value": "#1D4ED8", "use": "Info notices, in-progress." }
    }
  },
  "font": {
    "display": { "family": "'Bricolage Grotesque', 'Inter', system-ui, sans-serif", "weight": 800, "letterSpacing": "-0.03em", "use": "Headings, prices, big numbers. Never for body text." },
    "body":    { "family": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "weights": [400, 500, 600, 700], "use": "Everything else." }
  },
  "fontSize": {
    "display": { "value": "40px", "lineHeight": "44px", "font": "display" },
    "h1":      { "value": "32px", "lineHeight": "36px", "font": "display" },
    "h2":      { "value": "24px", "lineHeight": "30px", "font": "display" },
    "h3":      { "value": "20px", "lineHeight": "26px", "font": "body", "weight": 600 },
    "body":    { "value": "16px", "lineHeight": "24px", "font": "body", "weight": 400 },
    "small":   { "value": "14px", "lineHeight": "20px", "font": "body", "weight": 400 },
    "caption": { "value": "12px", "lineHeight": "16px", "font": "body", "weight": 500 }
  },
  "space": { "0": "0px", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
  "radius": { "sm": "6px", "md": "10px", "lg": "16px", "xl": "24px", "pill": "999px" },
  "shadow": {
    "card":   "0 1px 2px rgba(28,31,36,0.06), 0 2px 8px rgba(28,31,36,0.06)",
    "raised": "0 4px 16px rgba(28,31,36,0.12)",
    "sheet":  "0 -8px 32px rgba(28,31,36,0.16)"
  },
  "motion": { "fast": "120ms", "base": "200ms", "slow": "320ms", "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
  "size": { "touchTarget": "48px", "buttonHeight": "48px", "inputHeight": "48px", "iconSm": "16px", "iconMd": "20px", "iconLg": "24px", "avatarSm": "40px", "avatarLg": "88px" }
}
